# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# --- MongoDB Atlas ---
# Full SRV connection string from Atlas, including database name.
# NEVER commit the real value - this file only holds the shape of it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/prism?retryWrites=true&w=majority

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Google Gemini ---
GEMINI_API_KEY=replace-with-your-own-gemini-key
GEMINI_MODEL=gemini-1.5-pro

# --- Google Maps Platform (used by the frontend, listed here for reference) ---
GOOGLE_MAPS_API_KEY=replace-with-your-own-maps-key

# --- Nominatim (OpenStreetMap) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=prism-cadastral-platform/1.0 ([email protected])

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
