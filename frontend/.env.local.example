# URL of the PRISM backend API (see backend/.env.example)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Google Maps Platform key with the Maps JavaScript API enabled.
# Restrict this key to your domain(s) in the Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-your-own-maps-key
